# Hidden local state is private unless explicitly shared below.
.*

# Repository metadata, GitHub Actions, and shared source-formatting configuration.
!.gitignore
!.gitattributes
!.gitmodules
!/.github/
!.editorconfig
!.swift-format
!.swiftlint.yml
!.swift-version
!.clang-format

# Swift Package Manager build artifacts
.build/
.swiftpm/

# Xcode and macOS local state
DerivedData/
*.xcuserstate
xcuserdata/
.DS_Store

# Vendored native dependencies (whisper.xcframework + sherpa-onnx static libs, ~131MB)
# If lost, re-obtain per docs: whisper b5130 xcframework (trimmed) + sherpa-onnx v1.13.8 osx-arm64 static-lib tarball
# (demucs.cpp is source-vendored in Sources/CDemucsCpp — no binary artifact)
Frameworks/

# Local credentials and environment overrides
.env
.env.*
!.env.example

# Generated media and runtime artifacts
*.mp4
*.mov
*.mkv
*.wav
*.mp3
